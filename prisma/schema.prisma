// ==========================================================
// HYASCKA — Prisma Schema
// Enterprise-grade schema supporting auth, CMS, CRM, and future expansion.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────
// Enums
// ─────────────────────────────────────

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  EDITOR
  CLIENT
  USER
  GUEST
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum BlogStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SCHEDULED
  REJECTED
  ARCHIVED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContactStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  CONVERTED
  LOST
  // Kept for backward compatibility with existing rows — not used by
  // new Lead-lifecycle code, but removing them would require rewriting
  // every existing Contact row's status, which risks losing history.
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum ProviderType {
  CREDENTIALS
  GOOGLE
  GITHUB
}

// ─────────────────────────────────────
// Auth — Role
// ─────────────────────────────────────

model Role {
  id        String     @id @default(cuid())
  name      RoleName   @unique
  users     User[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// ─────────────────────────────────────
// Auth — User
// ─────────────────────────────────────

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String             @unique
  emailVerified     DateTime?
  password          String?
  image             String?
  bio               String?
  roleId            String
  role              Role               @relation(fields: [roleId], references: [id])
  accounts          Account[]
  sessions          Session[]
  verificationToken VerificationToken?
  resetTokens       PasswordResetToken[]
  contactSubmissions Contact[]
  blogPosts         Blog[]
  orders            Order[]
  verifiedPayments  Payment[]
  invoices          Invoice[]
  clientServices    ClientService[]
  assignedContacts       Contact[]                 @relation("ContactAssignedTo")
  createdOffers          CustomOffer[]             @relation("OfferCreatedBy")
  clientOffers           CustomOffer[]             @relation("OfferClient")
  conversationParticipant ConversationParticipant[]
  sentMessages           Message[]
  notifications          Notification[]
  sentInvitations        ClientInvitation[]        @relation("InvitationInvitedBy")
  auditLogs              AuditLog[]
  activityLogs            ActivityLog[]
  uploadedMedia           Media[]
  testimonials            Testimonial[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([roleId])
}

// ─────────────────────────────────────
// Auth — Account (OAuth)
// ─────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ─────────────────────────────────────
// Auth — Session
// ─────────────────────────────────────

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────
// Auth — Verification Token
// ─────────────────────────────────────

model VerificationToken {
  id      String    @id @default(cuid())
  identifier String
  token   String    @unique
  expires DateTime
  userId  String?   @unique
  user    User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier])
}

// ─────────────────────────────────────
// Auth — Password Reset Token
// ─────────────────────────────────────

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([email])
}

// ─────────────────────────────────────
// CMS — Category
// ─────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  description String?
  blogs     Blog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────
// CMS — Tag
// ─────────────────────────────────────

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  blogs     Blog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────
// CMS — Blog
// ─────────────────────────────────────

model Blog {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  excerpt     String?
  content     String?
  featuredImage String?
  // Additional in-article images, beyond the single featuredImage cover.
  contentImages String[]  @default([])
  status      BlogStatus  @default(DRAFT)
  readingTime Int         @default(5)
  authorId    String?
  author      User?       @relation(fields: [authorId], references: [id])
  // Per-post snapshot of the author's title (e.g. "Senior SEO Strategist")
  // — kept on Blog rather than User because a person's byline title can
  // reasonably differ across posts/time, and User has no such field.
  authorDesignation String?
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  tags        Tag[]
  comments    Comment[]
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([authorId])
}

// Real Media Library backing store. Every upload through /api/upload
// (blog covers, project images, service images, avatars, ...) creates one
// row here — this is what makes the dashboard Media Library page real
// instead of a list nothing ever populates.
model Media {
  id           String   @id @default(cuid())
  url          String
  publicId     String   @unique
  folder       String   @default("hyaska")
  fileType     String
  width        Int?
  height       Int?
  size         Int?
  title        String?
  altText      String?
  caption      String?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([folder])
  @@index([uploadedById])
}

// Real Social Links backing store (PRD section 19). Replaces the footer's
// previously hardcoded, non-functional href="#" icons and the unused
// constants/social.ts file — neither was ever connected to the dashboard's
// SiteSettings.socialLinks JSON blob (which itself only the Settings page
// reads/writes and nothing public ever consumed).
model SocialLink {
  id       String  @id @default(cuid())
  platform String
  url      String
  icon     String?
  label    String?
  active   Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Comment {
  id        String        @id @default(cuid())
  blogId    String
  blog      Blog          @relation(fields: [blogId], references: [id], onDelete: Cascade)
  name      String
  email     String
  content   String
  // New comments default to PENDING and are never publicly visible until
  // a moderator approves them — this IS the spam mitigation the PRD asks
  // for ("do not automatically publish suspicious comments"), rather than
  // a content-inspection heuristic.
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([blogId])
  @@index([status])
}

// ─────────────────────────────────────
// CMS — Technology
// ─────────────────────────────────────

model Technology {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  description String?
  icon        String?
  category    String?
  projects    Project[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ─────────────────────────────────────
// CMS — Service
// ─────────────────────────────────────

enum ServiceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  // "Service Group" in the dashboard UI — same model, reused rather than
  // duplicated (see Phase 3.5 schema-safety note). order/isActive are new:
  // existing rows default to order=0, isActive=true, so nothing already
  // stored needs to change.
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum ServiceAcquisitionType {
  FIXED_PRICE
  CUSTOM_QUOTE
}

model Service {
  id               String           @id @default(cuid())
  title            String           @unique
  slug             String           @unique
  shortDescription String?
  description      String?
  // "Our Approach" section on the public service detail page — kept
  // distinct from `description` ("What We Do"), which PRD section 8
  // treats as a separate content block.
  approach         String?
  image            String?
  icon             String?
  features         String[]
  order            Int              @default(0)
  featured         Boolean          @default(false)
  categoryId       String?
  category         ServiceCategory? @relation(fields: [categoryId], references: [id])
  price            Decimal?         @db.Decimal(10, 2)
  currency         String           @default("USD")
  acquisitionType  ServiceAcquisitionType @default(FIXED_PRICE)
  deliveryTime     String?
  status           ServiceStatus    @default(PUBLISHED)
  seoTitle         String?
  seoDescription   String?
  orders           Order[]
  clientServices   ClientService[]
  invoices         Invoice[]
  offerItems       OfferItem[]
  testimonials     Testimonial[]
  faqs             FAQ[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([categoryId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

// Financial records are never hard-deleted (see Order/Payment/Invoice —
// none have onDelete: Cascade toward destructive removal of history).
// serviceId and offerId are mutually exclusive in practice (an order is
// either a single standard-service purchase or a custom-offer purchase) —
// enforced in application code, since Postgres CHECK constraints for this
// XOR shape aren't worth the added migration complexity here.
model Order {
  id            String         @id @default(cuid())
  orderNumber   String         @unique
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  serviceId     String?
  service       Service?       @relation(fields: [serviceId], references: [id])
  offerId       String?        @unique
  offer         CustomOffer?   @relation(fields: [offerId], references: [id])
  amount        Decimal        @db.Decimal(10, 2)
  currency      String
  status        OrderStatus    @default(PENDING)
  // Denormalized cache of payment.status, kept in sync inside the same
  // transaction that updates Payment — lets order lists/queries avoid a
  // join for the common case, while Payment remains the source of truth.
  paymentStatus PaymentStatus  @default(PENDING)
  notes         String?
  payment       Payment?
  invoice       Invoice?
  clientServices ClientService[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([serviceId])
  @@index([status])
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String        @unique
  order        Order         @relation(fields: [orderId], references: [id])
  // "MANUAL" today (admin-confirmed bank transfer / offline payment).
  // A real gateway (Stripe, SSLCommerz, etc.) is a new value here plus
  // its own verification route — this field is what makes that a
  // non-breaking addition later rather than a redesign.
  provider     String        @default("MANUAL")
  reference    String?
  amount       Decimal       @db.Decimal(10, 2)
  currency     String
  status       PaymentStatus @default(PENDING)
  paidAt       DateTime?
  verifiedById String?
  verifiedBy   User?         @relation(fields: [verifiedById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
}

enum InvoiceStatus {
  UNPAID
  PAID
  VOID
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  // Nullable: a Phase 2 single-service order always has one; a Phase 3
  // custom-offer order may bundle several (see OfferItem on the offer).
  serviceId     String?
  service       Service?      @relation(fields: [serviceId], references: [id])
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  currency      String
  status        InvoiceStatus @default(UNPAID)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

enum ClientServiceStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model ClientService {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  serviceId   String
  service     Service             @relation(fields: [serviceId], references: [id])
  // Not @unique: a Phase 2 order activates exactly one ClientService, but
  // a Phase 3 custom-offer order can activate several (one per OfferItem
  // that references a real Service).
  orderId     String
  order       Order               @relation(fields: [orderId], references: [id])
  status      ClientServiceStatus @default(ACTIVE)
  activatedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([status])
  @@index([orderId])
}

// ─────────────────────────────────────
// CMS — Project / Portfolio
// ─────────────────────────────────────

model Project {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  category    String
  overview    String?
  challenge   String?
  solution    String?
  outcome     String?
  image       String?
  gallery     String[]
  techStack   String[]
  metrics     String?
  status      ProjectStatus  @default(COMPLETED)
  // Publish visibility, independent of `status` (project lifecycle stage).
  // A project can be internally COMPLETED but still a private draft, or
  // IN_PROGRESS and already shown publicly as a live case study — the two
  // are separate concerns. Public pages must filter on `published`, never
  // on `status` alone.
  published   Boolean        @default(false)
  order       Int            @default(0)
  projectUrl  String?
  clientName  String?
  seoTitle    String?
  seoDescription String?
  featured    Boolean        @default(false)
  technologies Technology[]
  testimonials Testimonial[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([category])
  @@index([published])
}

// ─────────────────────────────────────
// CMS — Portfolio (alias to Project for API flexibility)
// ─────────────────────────────────────

// Portfolio is represented by the Project model with featured = true.
// This keeps the schema DRY while allowing distinct API endpoints.

// ─────────────────────────────────────
// CRM — Contact
// ─────────────────────────────────────

enum ContactPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Contact IS the Lead model — it already had name/email/phone/message/
// status/userId, exactly what a Lead needs (see Phase 3 audit). Extended
// rather than duplicated. ContactStatus gains new values additively
// (IN_PROGRESS/RESOLVED/ARCHIVED are kept, not removed, so existing rows
// stay valid) rather than being destructively redefined.
model Contact {
  id             String          @id @default(cuid())
  name           String
  email          String
  phone          String?
  company        String?
  service        String?
  budget         String?
  message        String
  status         ContactStatus   @default(NEW)
  priority       ContactPriority @default(MEDIUM)
  source         String          @default("CONTACT_FORM")
  isCustomRequest Boolean        @default(false)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id])
  assignedToId   String?
  assignedTo     User?           @relation("ContactAssignedTo", fields: [assignedToId], references: [id])
  offers         CustomOffer[]
  conversations  Conversation[]
  invitations    ClientInvitation[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([email])
  @@index([assignedToId])
}

// ─────────────────────────────────────
// CRM — Client Invitation
// ─────────────────────────────────────

// A guest Lead (Contact) has no User account, so it can't securely receive
// Offers/Orders/Messages. This is the invite that converts one: staff sends
// it to the lead's email, the recipient sets a password, and a real CLIENT
// User is created and linked back to the lead — same secure-token pattern
// as PasswordResetToken (single-use, expiring, looked up by opaque token,
// never a trusted client-supplied id).
model ClientInvitation {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique
  leadId      String
  lead        Contact   @relation(fields: [leadId], references: [id])
  invitedById String
  invitedBy   User      @relation("InvitationInvitedBy", fields: [invitedById], references: [id])
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([leadId])
  @@index([token])
}

enum OfferStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model CustomOffer {
  id            String        @id @default(cuid())
  offerNumber   String        @unique
  title         String
  description   String?
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  validUntil    DateTime?
  status        OfferStatus   @default(DRAFT)
  rejectReason  String?
  createdById   String
  createdBy     User          @relation("OfferCreatedBy", fields: [createdById], references: [id])
  // Nullable: a lead without a registered account can still receive a
  // DRAFT offer for internal prep, but it can't be sent/accepted until
  // linked to a real User (see Phase 3 report — no account-invite flow yet).
  clientId      String?
  client        User?         @relation("OfferClient", fields: [clientId], references: [id])
  contactId     String
  contact       Contact       @relation(fields: [contactId], references: [id])
  items         OfferItem[]
  order         Order?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([clientId])
  @@index([contactId])
}

model OfferItem {
  id        String      @id @default(cuid())
  offerId   String
  offer     CustomOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  // Nullable: an item can reference an existing Service for pricing
  // consistency, or be a fully custom line (label + amount only).
  serviceId String?
  service   Service?    @relation(fields: [serviceId], references: [id])
  label     String
  amount    Decimal     @db.Decimal(10, 2)
  order     Int         @default(0)
}

model Conversation {
  id           String                    @id @default(cuid())
  subject      String?
  contactId    String?
  contact      Contact?                  @relation(fields: [contactId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([contactId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

enum NotificationType {
  NEW_LEAD
  LEAD_ASSIGNED
  NEW_OFFER
  OFFER_ACCEPTED
  OFFER_REJECTED
  OFFER_EXPIRED
  NEW_MESSAGE
  PAYMENT_CONFIRMED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, readAt])
}

// ─────────────────────────────────────
// Newsletter
// ─────────────────────────────────────

model Newsletter {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─────────────────────────────────────
// CMS — FAQ
// ─────────────────────────────────────

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  active    Boolean  @default(true)
  // null = global FAQ (shown on the general FAQ section); set = scoped to
  // one service's detail page. Reuses this single model for both rather
  // than duplicating it as a separate ServiceFAQ model.
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
}

// ─────────────────────────────────────
// CMS — Testimonial
// ─────────────────────────────────────

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  name      String
  position  String
  company   String?
  initials  String
  rating    Int      @default(5)
  // `active` still gates public visibility directly (unchanged query
  // behavior everywhere it's already used); `status` is the moderation
  // record of how it got there. Both are kept in sync by the
  // approve/reject actions rather than merged into one field, so an
  // approved testimonial can still be temporarily hidden without losing
  // the fact that it was reviewed and approved.
  active    Boolean  @default(true)
  status    TestimonialStatus @default(APPROVED)
  image     String?
  permissionToPublish Boolean @default(true)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
}

// ─────────────────────────────────────
// Settings — Site Settings
// ─────────────────────────────────────

model SiteSettings {
  id              String   @id @default(cuid())
  siteName        String   @default("HYASCKA")
  siteUrl         String?
  logo            String?
  favicon         String?
  description     String?
  email           String?
  phone           String?
  address         String?
  socialLinks     Json?
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  analyticsId     String?
  // Tracking integrations (PRD section 18). Each has its own enabled flag
  // — the site must not inject a script when disabled, regardless of
  // whether an ID is still saved. All values here are public client-side
  // identifiers (a Pixel ID, a Measurement ID, ...), never secrets — the
  // one exception, metaCapiAccessToken, is deliberately never returned by
  // GET /api/dashboard/settings (see that route).
  fbPixelId          String?
  fbPixelEnabled     Boolean @default(false)
  metaCapiAccessToken String?
  metaCapiEnabled    Boolean @default(false)
  gtmContainerId     String?
  gtmEnabled         Boolean @default(false)
  ga4MeasurementId   String?
  ga4Enabled         Boolean @default(false)
  clarityProjectId   String?
  clarityEnabled     Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────
// Audit Log — who did what, when
// ─────────────────────────────────────

// Append-only. Written by lib/audit-log.ts from sensitive dashboard
// mutations (role changes, deletions, settings/payment updates) — never
// updated or deleted by application code. actorId is nullable because a
// handful of write paths (e.g. a public form submission that indirectly
// triggers a system action) have no authenticated actor.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// Operational activity feed — distinct from AuditLog (security-sensitive,
// SUPER_ADMIN-only). ActivityLog is the everyday "what's happening on the
// platform" timeline (new lead, offer accepted, message sent, ...) surfaced
// to SUPER_ADMIN/ADMIN on /dashboard/activity. Never store secrets/passwords
// here; `description` is the human-readable line rendered directly in the UI.
model ActivityLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])
  actorRole   String?
  action      String
  targetType  String?
  targetId    String?
  description String
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}